# Backend service (FastAPI). Dev/standalone image — used directly by docker-compose.
# For the collapsed single-process production image, see the root Dockerfile.
FROM python:3.13-slim

WORKDIR /app

# System deps for pymupdf (fitz) wheels build cleanly on slim without extra libs,
# but curl is handy for the HEALTHCHECK below.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download SentenceTransformer (BAAI/bge-small-en-v1.5) & CrossEncoder model weights into the image cache
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer('BAAI/bge-small-en-v1.5'); CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

COPY backend ./backend
COPY data/sources.yaml ./data/sources.yaml
COPY data/corpus ./data/corpus

# .env is not baked in — supplied at runtime via docker-compose env_file or -e flags.
# data/index is a volume: it's generated by `ingest`, never shipped in the image.

# The entrypoint builds the index on first boot when the volume is empty.
# sed strips CRLF so the shebang still resolves when the build context came
# from a Windows checkout.
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

EXPOSE 8000

# start-period covers the first-boot ingest (~35s for NG243).
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
