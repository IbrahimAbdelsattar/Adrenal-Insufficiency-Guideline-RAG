# Clinical Decision Support Lite — configuration
# Copy to .env and fill in OPENROUTER_API_KEY. Never commit .env.

# --- Model provider: OmniRoute gateway (research.md D3, D3a) ---
# Public endpoint from the OmniRoute dashboard (Endpoints -> APIs).
# The local alternative is http://localhost:20128/v1 when the gateway runs on this machine.
# NOTE: the provider is OmniRoute, not OpenRouter. The legacy OPENROUTER_* names
# are still accepted as a fallback, but prefer these.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://omniroute.dawrly.space/v1

# --- Embeddings & Local-First Provider ---
# Local embedding model is primary for ultra-low latency (<30ms) and offline reliability.
# Remote Gemini model serves as high-availability fallback if local inference fails.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REMOTE_EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_BATCH_SIZE=32
ENABLE_EMBEDDING_FALLBACK=true
FALLBACK_CHROMA_COLLECTION=guidelines_remote

# --- Generation (Day 2 / Day 3) ---
# Must be a model your gateway has upstream credentials for. Check with:
#   curl -s $OMNIROUTE_BASE_URL/models -H "Authorization: Bearer $OMNIROUTE_API_KEY"
# On this instance the direct anthropic/* routes return
# "No active credentials for provider: anthropic";
GENERATION_MODEL=eva-ai
# Reasoning models spend part of this budget thinking before they write. At 1024
# the whole budget went to the <think> block and the answer was truncated away.
GENERATION_MAX_TOKENS=4096
GENERATION_TEMPERATURE=0.1

# --- Chunking (research.md D6) ---
# Tuned against the golden set: 250 tokens (48 chunks) scored the best precision
# while keeping a 100% hit rate. Raising this dilutes precision; lowering it
# starts dropping whole guideline sections from retrieval.
CHUNK_TARGET_TOKENS=250
CHUNK_MIN_TOKENS=150
CHUNK_MAX_TOKENS=350

# --- Retrieval ---
# k=3 scored highest precision in the Day 2 eval and cuts prompt tokens.
TOP_K=3
RETRIEVER_TYPE=hybrid
HYBRID_CANDIDATE_K=20

# Relevance floor and scope threshold for gating evidence & abstention
# Calibrated for local BAAI/bge-small-en-v1.5: in-scope 0.76-0.82, out-of-scope <= 0.64
RELEVANCE_FLOOR=0.68
SCOPE_THRESHOLD=0.68


# --- Graph expansion (lightweight Graph RAG) ---
GRAPH_EXPANSION=true
GRAPH_MAX_EXPAND=1

# --- Multi-Tier Cache Configuration ---
RESPONSE_CACHE_SIZE=512
RETRIEVAL_CACHE_SIZE=512
EMBEDDING_CACHE_SIZE=1024
CACHE_TTL_SECONDS=3600


# --- Paths ---
CORPUS_DIR=data/corpus
SOURCES_FILE=data/sources.yaml
INDEX_DIR=data/index
CHROMA_COLLECTION=guidelines

# --- Cleaning (research.md D5) ---
# Line frequency across pages above which text is treated as boilerplate.
BOILERPLATE_PAGE_RATIO=0.6

# --- Logging & RAG observability ---
# LOG_LEVEL=DEBUG additionally logs per-chunk retrieval scores, BM25 term
# matches, and embedding cache hits.
LOG_LEVEL=INFO
# text = human-readable (local dev); json = one JSON object per line (deployed).
LOG_FORMAT=text
# Clinical queries can carry PHI. Logged query text is always scrubbed
# (emails/phones/MRNs/SSNs) and truncated; set false to drop it entirely.
LOG_QUERY_TEXT=true
LOG_QUERY_MAX_CHARS=200
# Requests at or above this are logged at WARNING with [SLOW].
SLOW_REQUEST_MS=5000
# Logs prompt/answer previews at DEBUG. Verbose and PHI-adjacent: debugging only.
LOG_PROMPT_PREVIEW=false
LOG_PREVIEW_CHARS=400

# --- Sentry Error & Performance Tracking ---
# Leave SENTRY_DSN empty to disable Sentry in local offline development.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- LangSmith RAG Tracing ---
# Leave LANGSMITH_API_KEY empty to disable RAG tracing locally.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eva-ai-rag
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=

