# Frontend service (Next.js) — PRODUCTION image.
#
# Runs a real Next server rather than a static export, because the VPS puts the
# frontend and backend behind separate domains and only a server can rewrite
# /api/* through to the backend.
#
# For local hot-reload development use docker-compose.dev.yml, which overrides
# the command and bind-mounts the source tree.

# --- Stage 1: install dependencies ---
FROM node:20-slim AS deps
WORKDIR /app
# The lockfile is resolved by npm >= 11, which keeps the optional wasm peer
# deps (@emnapi/core, @emnapi/runtime) that @tailwindcss/oxide-wasm32-wasi
# declares. node:20-slim ships npm 10, which resolves those differently and
# fails `npm ci` with "Missing: @emnapi/runtime from lock file". Pin npm so the
# image agrees with whatever npm the lockfile was generated by.
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund

# --- Stage 2: build ---
FROM node:20-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# IMPORTANT: Next evaluates next.config.ts `rewrites()` at BUILD time and
# serializes the result into the build manifest. Setting BACKEND_URL only at
# runtime has no effect — the proxy target is frozen here. It must therefore be
# supplied as a build arg, defaulting to the compose service address.
ARG BACKEND_URL=http://backend:8000
ENV BACKEND_URL=${BACKEND_URL}

# Browser-side API base. Empty = same-origin (local dev, single-process image).
# On the split VPS deployment set this to the backend's public domain so POSTs
# skip the Next rewrite, which Traefik makes Next reject as an invalid host.
# NEXT_PUBLIC_* is inlined at build time, hence a build arg rather than env.
ARG NEXT_PUBLIC_API_BASE=""
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}

ENV NEXT_TELEMETRY_DISABLED=1
RUN NODE_ENV=production npm run build

# --- Stage 3: runtime ---
FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# `output: "standalone"` emits a self-contained server plus only the modules it
# actually needs; static/ and public/ are copied alongside it.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
